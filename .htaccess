Options -Indexes +FollowSymLinks
RewriteEngine On

# Block access to source and sensitive files
RewriteRule ^(src|\.env|\.gitignore|\.git|composer\.json|package\.json|package-lock\.json)(/|$) - [F,L]

# 1. Remove index.php (External Redirect)
RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\ /(.+/)?index\.php\ [NC]
RewriteRule ^(.+/)?index\.php$ /%1 [R=301,L]

# 2. Remove .php extension (External Redirect)
RewriteCond %{THE_REQUEST} \s/+(.+?)\.php[\s?] [NC]
RewriteRule ^ /%1 [R=301,L]

# 3. Handle trailing slashes (Redirect folder/ to folder)
# Only if it's NOT a real directory to avoid Apache loops
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_URI} ^(.+)/$
RewriteRule ^ %1 [R=301,L]

# 4. Internal rewrite: Map clean URL to .php file
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.php -f
RewriteRule ^(.+)$ $1.php [L]

DirectoryIndex index.php index.html
