extends ../layouts/main.pug

block vars
  - var title = "Aplikasi Rapor Digital & Sekolah - Smart Education"
  - var baseUrl = "../"

block nav_links
  a.transition(href="index.html" class="hover:text-brand-black") Home
  a.transition(href="index.html#services" class="hover:text-brand-black") Layanan
  a.transition(href="blog/vibe-coding-vs-production-grade.html" class="hover:text-brand-black") Blog

block content
  main.max-w-4xl.mx-auto.px-6.py-24
    section.mb-20
      .text-xs.font-semibold.tracking-widest.text-brand-gray.mb-4.uppercase Education Tech
      h1.text-5xl.font-semibold.hero-title.text-brand-black.mb-8(class="md:text-7xl")
        | Aplikasi 
        span.editorial-italic.font-normal Rapor.
      p.text-xl.text-brand-gray.leading-relaxed
        | Digitalisasi manajemen nilai dan laporan sekolah. Hilangkan beban administrasi guru agar mereka bisa fokus mengajar. Aman, cepat, dan sesuai kurikulum.

    section.grid.grid-cols-1.gap-12.mb-20(class="md:grid-cols-2")
      div
        h2.text-2xl.font-semibold.mb-6 Solutions
        ul.space-y-4.text-brand-gray
          li.flex.items-start
            span.text-brand-black.font-bold.mr-3 —
            | Digital Gradebook
          li.flex.items-start
            span.text-brand-black.font-bold.mr-3 —
            | Automatic Report Generation
          li.flex.items-start
            span.text-brand-black.font-bold.mr-3 —
            | Student Attendance System
          li.flex.items-start
            span.text-brand-black.font-bold.mr-3 —
            | Parent Portal Access
      .bg-brand-light.p-10.rounded-3xl.border.border-gray-100
        h2.text-2xl.font-semibold.mb-4.text-brand-black.italic.serif Reliability First
        p.text-brand-gray.leading-relaxed.text-sm
          | Data nilai adalah aset kritis. Kami membangun sistem dengan enkripsi dan 
          span.editorial-italic automated backups
          |  untuk menjamin keamanan data siswa Anda selamanya.

    section.text-center.pt-12.border-t.border-gray-100
      a.bg-brand-black.text-white.text-lg.font-medium.px-12.py-5.rounded-2xl.transition.shadow-lg(href="https://wa.link/byybuo" class="hover:bg-gray-800")
        | Konsultasi Gratis
