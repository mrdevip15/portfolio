extends ../layouts/main.pug

block vars
  - var title = "Blog | Engineering Insights"
  - var baseUrl = "../"

block nav_links
  a.transition(href=baseUrl + "index.html" class="hover:text-brand-black") Home
  a.transition(href=baseUrl + "index.html#work" class="hover:text-brand-black") Work
  a.transition(href=baseUrl + "jasabikinwebsite/index.html" class="hover:text-brand-black") Agency

block content
  main.max-w-4xl.mx-auto.px-6.py-24
    section.mb-20
      h1.text-5xl.font-semibold.hero-title.text-brand-black.mb-8(class="md:text-7xl")
        | Engineering 
        span.editorial-italic.font-normal Journal.
      p.text-xl.text-brand-gray.leading-relaxed
        | Thoughts on software architecture, automation, and the future of web engineering.

    section.space-y-12
      //- Blog Item 1
      a.group.block.py-10.border-b.border-gray-100(href="claw-revolution.html")
        .text-xs.font-bold.tracking-widest.text-brand-gray.mb-3.uppercase Security // 2026.04.15
        h2.text-3xl.font-semibold.mb-4.transition(class="group-hover:text-brand-black") The Claw Revolution: Reshaping Web Security
        p.text-brand-gray.leading-relaxed Exploring new paradigms in distributed security systems and why the old models are failing.
      
      //- Blog Item 2
      a.group.block.py-10.border-b.border-gray-100(href="sequelize-vuln.html")
        .text-xs.font-bold.tracking-widest.text-brand-gray.mb-3.uppercase Backend // 2026.03.20
        h2.text-3xl.font-semibold.mb-4.transition(class="group-hover:text-brand-black") Analyzing Critical Vulnerabilities in Sequelize ORM
        p.text-brand-gray.leading-relaxed A deep dive into common pitfalls when using ORMs in production environments.
      
      //- Blog Item 3
      a.group.block.py-10.border-b.border-gray-100(href="silent-blockers.html")
        .text-xs.font-bold.tracking-widest.text-brand-gray.mb-3.uppercase Performance // 2026.02.10
        h2.text-3xl.font-semibold.mb-4.transition(class="group-hover:text-brand-black") Silent Blockers: Why Your App Feels Slow
        p.text-brand-gray.leading-relaxed Identifying non-obvious performance bottlenecks in modern JavaScript applications.
