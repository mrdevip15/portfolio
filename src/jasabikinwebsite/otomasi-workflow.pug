extends ../layouts/main.pug

block vars
  - var title = "Otomasi Workflow Kantor - Industrial Logic"
  - var baseUrl = "../"

block nav_links
  a.transition(href="index.html" class="hover:text-brand-black") Home
  a.transition(href="index.html#services" class="hover:text-brand-black") Layanan
  a.transition(href="blog/vibe-coding-vs-production-grade.html" class="hover:text-brand-black") Blog

block content
  main.max-w-4xl.mx-auto.px-6.py-24
    section.mb-20
      .text-xs.font-semibold.tracking-widest.text-brand-gray.mb-4.uppercase Workflow Logic
      h1.text-5xl.font-semibold.hero-title.text-brand-black.mb-8(class="md:text-7xl")
        | Otomasi 
        span.editorial-italic.font-normal Workflow.
      p.text-xl.text-brand-gray.leading-relaxed
        | Hubungkan aplikasi-aplikasi yang Anda gunakan dan biarkan sistem bekerja sendiri. Kurangi human error dan percepat proses bisnis Anda secara signifikan.

    section.grid.grid-cols-1.gap-12.mb-20(class="md:grid-cols-2")
      div
        h2.text-2xl.font-semibold.mb-6 Integrations
        ul.space-y-4.text-brand-gray
          li.flex.items-start
            span.text-brand-black.font-bold.mr-3 —
            | API Integration (REST/SOAP)
          li.flex.items-start
            span.text-brand-black.font-bold.mr-3 —
            | Database Synchronization
          li.flex.items-start
            span.text-brand-black.font-bold.mr-3 —
            | Cloud Services Automation
          li.flex.items-start
            span.text-brand-black.font-bold.mr-3 —
            | Custom ERP Modules
      .bg-brand-light.p-10.rounded-3xl.border.border-gray-100
        h2.text-2xl.font-semibold.mb-4.text-brand-black.italic.serif Logical Rigidity
        p.text-brand-gray.leading-relaxed.text-sm
          | Otomasi bukan cuma soal "nyambungin", tapi soal logika bisnis yang presisi. Kami memastikan setiap 
          span.editorial-italic edge case
          |  ditangani dengan benar untuk sistem yang tangguh.

    section.text-center.pt-12.border-t.border-gray-100
      a.bg-brand-black.text-white.text-lg.font-medium.px-12.py-5.rounded-2xl.transition.shadow-lg(href="https://wa.link/byybuo" class="hover:bg-gray-800")
        | Konsultasi Workflow
